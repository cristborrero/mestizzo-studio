# -----------------------------------------------------------------------------
# MESTIZZO STUDIO - Template de Variables de Entorno
# -----------------------------------------------------------------------------
# Copia este archivo como .env.local y completa con tus credenciales reales.
# NUNCA subas el archivo .env.local al repositorio.
# -----------------------------------------------------------------------------

# --- BASE DE DATOS (PostgreSQL / Vercel Storage) ---
# URL de conexión principal a la base de datos (Drizzle ORM)
DATABASE_URL=postgresql://user:password@hostname:port/dbname?sslmode=require
# Alias para compatibilidad con Vercel Postgres
POSTGRES_URL=postgresql://user:password@hostname:port/dbname?sslmode=require

# --- AUTENTICACIÓN (Auth.js / NextAuth v5) ---
# Secreto para firmar las cookies de sesión. Generar con: 'npx auth secret'
AUTH_SECRET=your-auth-secret
# URL base de la aplicación (ej. http://localhost:3000 o https://tu-dominio.com)
AUTH_URL=http://localhost:3000
# Requerido para despliegues fuera de Vercel para confiar en los encabezados del host
AUTH_TRUST_HOST=true

# --- GOOGLE OAUTH (Login de Admin) ---
# ID de Cliente de Google Cloud Console (APIs & Services > Credentials)
AUTH_GOOGLE_ID=your-google-client-id
# Secreto de Cliente de Google Cloud Console
AUTH_GOOGLE_SECRET=your-google-client-secret

# --- COMUNICACIONES (Email / Resend) ---
# API Key de Resend (resend.com) para el formulario de contacto y notificaciones
RESEND_API_KEY=re_your_api_key

# --- PAGOS (PayPal Integration) ---
# Client ID de PayPal Developer (developer.paypal.com). Pública para el SDK de JS.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id